# TinyAI Environment Configuration Template
# Copy to .env and configure as appropriate.

# Control Plane Service
CONTROL_PLANE_PORT=8081
SPRING_PROFILES_ACTIVE=dev

# ML Engine & Optimization API
ML_ENGINE_PORT=8000
ARTIFACTS_DIR=./artifacts
MAX_FILE_SIZE_MB=50

# Frontend UI
VITE_API_URL=http://127.0.0.1:8000

# Edge Benchmarking Configuration
BENCHMARK_WARMUP_RUNS=15
BENCHMARK_TIMING_RUNS=100
DEFAULT_RANDOM_SEED=42
